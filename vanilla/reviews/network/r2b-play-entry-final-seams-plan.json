  "scope": "Reusable dynamic wire primitives only. Commands and synchronized recipes are composition-locked artifacts for this profile; non-empty ItemStack, world/chunk/light/movement and gameplay helpers are forbidden.",
  "groups": [
    {
      "group_id": "GENERIC_REGISTRY_WIRE",
      "review_focus": "Close map and registry-holder/id-mapper encoding used by dynamic clock and dimension-holder projection.",
      "selectors": [
        {
          "mode": "type_name_regex",
          "required": true,
          "type_name": "net.minecraft.network.codec.ByteBufCodecs",
          "name_regex": "^(map|holderRegistry|holder|registry|registryKey|idMapper)$"
        }
      ]
    },
    {
      "group_id": "GLOBAL_POS_WIRE",
      "review_focus": "Close GlobalPos.STREAM_CODEC and exactly the reusable resource-key/packed-position primitives delegated by default-spawn projection.",
      "selectors": [
        {
          "mode": "type_all",
          "required": true,
          "type_name": "net.minecraft.core.GlobalPos"
        },
        {
          "mode": "type_names",
          "required": true,
          "type_name": "net.minecraft.resources.ResourceKey",
          "names": ["streamCodec"]
        },
        {
          "mode": "type_name_regex",
          "required": true,
          "type_name": "net.minecraft.core.BlockPos",
          "name_regex": "^(<clinit>|of|asLong)$"
        }
      ]
    }
  ]
