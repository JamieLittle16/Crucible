{
  "schema": 1,
  "description": "Narrow discovery-only official-source frontier for the R0 multiplayer-list milestone. Roots are a strict subset of the broader P0 pre-play frontier and identify only connection, handshake and status/ping review anchors. They are not packet IDs, semantic assertions or an admission gate.",
  "max_depth": 8,
  "include_package_prefixes": [
    "net.minecraft.network",
    "net.minecraft.server.network"
  ],
  "exclude_package_prefixes": [
    "net.minecraft.data",
    "net.minecraft.gametest",
    "net.minecraft.network.protocol.game"
  ],
  "root_queries": [
    "net.minecraft.network.Connection",
    "net.minecraft.network.ProtocolInfo",
    "net.minecraft.network.protocol.Packet",
    "net.minecraft.network.protocol.handshake.ClientIntentionPacket",
    "net.minecraft.server.network.ServerHandshakePacketListenerImpl",
    "net.minecraft.network.protocol.status.ServerboundStatusRequestPacket",
    "net.minecraft.network.protocol.status.ClientboundStatusResponsePacket",
    "net.minecraft.network.protocol.status.ServerboundPingRequestPacket",
    "net.minecraft.network.protocol.status.ClientboundPongResponsePacket"
  ]
}
