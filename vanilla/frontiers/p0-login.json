{
  "schema": 1,
  "description": "Discovery-only official-source frontier for the P0 Login slice and its handoff into Configuration. Roots are a strict subset of the broader P0 pre-play frontier. They are review anchors only, not packet IDs, semantic assertions, authentication policy or an admission gate.",
  "max_depth": 8,
  "include_package_prefixes": [
    "net.minecraft.network",
    "net.minecraft.server.network"
  ],
  "exclude_package_prefixes": [
    "net.minecraft.data",
    "net.minecraft.gametest",
    "net.minecraft.network.protocol.game"
  ],
  "root_queries": [
    "net.minecraft.network.Connection",
    "net.minecraft.network.ProtocolInfo",
    "net.minecraft.network.protocol.Packet",
    "net.minecraft.network.protocol.handshake.ClientIntentionPacket",
    "net.minecraft.server.network.ServerHandshakePacketListenerImpl",
    "net.minecraft.network.protocol.login.ServerboundHelloPacket",
    "net.minecraft.network.protocol.login.ClientboundLoginFinishedPacket",
    "net.minecraft.server.network.ServerLoginPacketListenerImpl"
  ]
}
