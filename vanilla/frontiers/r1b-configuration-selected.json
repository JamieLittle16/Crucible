    "net.minecraft.tags",
    "net.minecraft.world.entity.player"
  ],
  "exclude_package_prefixes": [
    "net.minecraft.data",
    "net.minecraft.gametest",
    "net.minecraft.network.protocol.status"
  ],
  "root_queries": [
    "net.minecraft.network.protocol.configuration.ConfigurationProtocols",
