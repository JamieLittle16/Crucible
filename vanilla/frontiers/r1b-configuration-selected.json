    "net.minecraft.server.network.ServerConfigurationPacketListenerImpl#startConfiguration()",
    "net.minecraft.server.network.ServerConfigurationPacketListenerImpl#handleClientInformation(final ServerboundClientInformationPacket packet)",
    "net.minecraft.server.network.ServerConfigurationPacketListenerImpl#handleSelectKnownPacks(final ServerboundSelectKnownPacks packet)",
    "net.minecraft.server.network.ServerConfigurationPacketListenerImpl#handleConfigurationFinished(final ServerboundFinishConfigurationPacket packet)",
